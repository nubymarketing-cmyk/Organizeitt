# Copie para .env.local e preencha. Nunca commite o .env.local.
# Enquanto VITE_SUPABASE_URL estiver vazio, o portal roda com dados de demonstração (mock).
VITE_SUPABASE_URL=
# Chave pública do projeto: "anon" ou "publishable" (Project Settings > API). Nunca a service_role.
VITE_SUPABASE_ANON_KEY=
# Endereço do portal, usado nos links mágicos dos e-mails.
VITE_APP_URL=http://localhost:5173
